# Don't cache the entry HTML or the version marker — they reference the hashed JS/CSS
# bundle, so a cached index.html keeps loading an old build (the stale-version problem).
# Hashed assets (assets/*) are content-addressed and safe to cache normally.
# Guarded by IfModule so it's a no-op if mod_headers isn't available (and ignored
# entirely on non-Apache hosts — set equivalent headers in the server config there).
<IfModule mod_headers.c>
  <FilesMatch "(index\.html|version\.json|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# GZIP THE SCENES. .sxr is float arrays with a lot of repetition (unpainted colours, materials
# and face groups are one value per vertex), and the server sent it raw: the head example was
# 15 MB over the wire and 3.4 MB gzipped. Browsers decode Content-Encoding transparently, and the
# example loader already treats Content-Length as the compressed size.
AddType application/octet-stream .sxr
<IfModule mod_deflate.c>
  <FilesMatch "\.sxr$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>
