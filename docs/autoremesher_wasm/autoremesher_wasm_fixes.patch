     };
     makeMesh(M, *m_vertices, *m_triangles);
 
+    // Face-group steering: mark the facet corners whose edge is a group seam via a
+    // "seam" corner attribute. Our patched geogram reads it in create_from_surface_mesh
+    // (so the frame field aligns to seams and is smoothly propagated by solve_PGP) and in
+    // get_edge_constraints (so seams become hard iso-line constraints regardless of the
+    // dihedral-angle test). Set it on BOTH the frame-field mesh and the quad_cover mesh.
+    std::set<std::pair<size_t, size_t>> seamSet;
+    if (m_seamEdges != nullptr) {
+        for (const auto& e : *m_seamEdges) {
+            size_t a = e.first, b = e.second;
+            seamSet.insert(a < b ? std::make_pair(a, b) : std::make_pair(b, a));
+        }
+    }
+    auto markSeam = [&](GEO::Mesh& mesh) {
+        if (seamSet.empty()) return;
+        GEO::Attribute<GEO::index_t> seam(mesh.facet_corners.attributes(), "seam");
+        for (GEO::index_t c = 0; c < mesh.facet_corners.nb(); ++c) {
+            GEO::index_t f = c / 3;
+            GEO::index_t cn = mesh.facets.next_corner_around_facet(f, c);
+            size_t v1 = mesh.facet_corners.vertex(c);
+            size_t v2 = mesh.facet_corners.vertex(cn);
+            auto key = v1 < v2 ? std::make_pair(v1, v2) : std::make_pair(v2, v1);
+            seam[c] = seamSet.count(key) ? 1 : 0;
+        }
+    };
+    markSeam(M);
+
     GEO::Attribute<GEO::vec3> B(M.facets.attributes(), "B");
     if (nullptr == m_triangleFieldVectors) {
         GEO::Mesh originalM;
         makeMesh(originalM, *m_vertices, *m_triangles);
+        markSeam(originalM); // so the frame field aligns to seams
 
         GEO::FrameField FF;
         FF.set_use_spatial_search(false);
